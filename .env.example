# ─── Frontend (Next.js server-side only) ────────────────────────────────────
# BACKEND_URL is read at runtime by the Next.js API route handler. It is never
# baked into the browser JS bundle.
# - docker compose: use http://backend:8000 (service name) so the frontend container
#   can reach the backend over the shared Docker network.
# - Production (Render): render.yaml supplies BACKEND_URL=https://radiology-backend-fhal.onrender.com.
BACKEND_URL=http://backend:8000
# BACKEND_HOSTPORT is intentionally unused in this free-tier setup; the frontend uses BACKEND_URL instead.

# ─── Backend (FastAPI) ───────────────────────────────────────────────────────
# Comma-separated list of exact origins allowed for CORS.
# No wildcards — wildcards are incompatible with allow_credentials=True.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
