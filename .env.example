# ─── Frontend (Next.js server-side only) ────────────────────────────────────
# BACKEND_URL is read at RUNTIME by the Next.js server process via next.config.ts
# rewrites(). It is never baked into the browser JS bundle.
# - `npm run dev` (outside Docker): use http://localhost:8000
# - docker compose: the compose file defaults to http://backend:8000 (service name)
# - Production (Render): set to https://radiology-backend-wc8z.onrender.com in render.yaml
BACKEND_URL=http://localhost:8000

# ─── Backend (FastAPI) ───────────────────────────────────────────────────────
# Comma-separated list of exact origins allowed for CORS.
# No wildcards — wildcards are incompatible with allow_credentials=True.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
