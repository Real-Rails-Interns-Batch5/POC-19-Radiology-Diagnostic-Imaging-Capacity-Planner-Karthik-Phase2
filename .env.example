# Frontend Environment Variables
# Note: NEXT_PUBLIC_API_URL is evaluated at BUILD TIME during `next build` (or client bundle generation).
# For local dev / client browser calls: http://localhost:8000
# For production deployments: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Environment Variables
# Comma-separated origins allowed to make CORS requests to the backend API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
