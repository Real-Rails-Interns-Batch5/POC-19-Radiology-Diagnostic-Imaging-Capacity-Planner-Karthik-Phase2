# =============================================================================
# .dockerignore — Root-level (applies when build context is the project root)
# For service-scoped builds (./backend, ./frontend), each service has its own
# .dockerignore that takes effect instead.
# =============================================================================

# Version control
.git
.gitignore
.github
.gitattributes

# Environment files — never bake secrets into images
.env
.env.*
!.env.example

# Frontend build artifacts & dependencies
**/node_modules
**/.next
**/out
**/build
**/*.tsbuildinfo

# Python artifacts & virtual environments
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/venv
**/.venv
**/env
**/.pytest_cache
**/coverage
**/.coverage
**/*.egg-info
**/*.egg
**/dist
**/site-packages

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
**/*.log
**/logs

# Documentation & project dumps
repomix-output.xml
README.md
AGENTS.md
CLAUDE.md

# Docker files themselves (not needed inside the image)
docker-compose*.yml
docker-compose*.yaml

# Test artifacts
**/test-results
**/playwright-report
**/jest-results
